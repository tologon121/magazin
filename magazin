let cartCount = 3;
let currentCat = 'all';
let currentPage = 1;
const perPage = 12;
let filteredProducts = [...products];
let isListView = false;

// ===== PAGE NAVIGATION =====
function showPage(page) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-' + page).classList.add('active');
  document.querySelectorAll('nav a').forEach(a => a.classList.remove('active'));
  if(page === 'home') document.getElementById('nav-home').classList.add('active');
  window.scrollTo(0, 0);
  if(page === 'home') renderHomeProducts();
}

function showElec(cat) {
  currentCat = cat;
  currentPage = 1;
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-elec').classList.add('active');
  document.querySelectorAll('nav a').forEach(a => a.classList.remove('active'));
  document.getElementById('nav-elec').classList.add('active');
  updateSubCats(cat);
  applyFilters();
  window.scrollTo(0, 0);
}

function filterSubCat(cat) {
  currentCat = cat;
  currentPage = 1;
  updateSubCats(cat);
  const labels = {all:'Электроника', phones:'Смартфондор', laptops:'Ноутбуктар', tablets:'Планшеттер', audio:'Аудио', watches:'Смарт саат', cameras:'Камералар', gaming:'Оюн консолу', accessories:'Аксессуарлар'};
  document.getElementById('bread-cat').textContent = labels[cat] || 'Электроника';
  applyFilters();
}

function updateSubCats(cat) {
  document.querySelectorAll('.sub-cat').forEach(el => el.classList.remove('active'));
  const el = document.getElementById('sc-' + cat);
  if(el) el.classList.add('active');
}

// ===== FILTERS =====
function applyFilters() {
  const minPrice = parseInt(document.getElementById('priceMin').value) || 0;
  const maxPrice = parseInt(document.getElementById('priceMax').value) || 999999;
  const sort = document.getElementById('sortSelect').value;
  const brands = ['apple','samsung','xiaomi','sony','lg','huawei'].filter(b => document.getElementById('b-'+b) && document.getElementById('b-'+b).checked);
  const onlyNew = document.getElementById('f-new') && document.getElementById('f-new').checked;
  const onlySale = document.getElementById('f-sale') && document.getElementById('f-sale').checked;
  const onlyStock = document.getElementById('f-instock') && document.getElementById('f-instock').checked;

  filteredProducts = products.filter(p => {
    if(currentCat !== 'all' && p.cat !== currentCat) return false;
    if(p.price < minPrice || p.price > maxPrice) return false;
    if(brands.length > 0 && !brands.includes(p.brand.toLowerCase())) return false;
    if(onlyNew && !p.isNew) return false;
    if(onlySale && !p.oldPrice) return false;
    if(onlyStock && !p.inStock) return false;
    return true;
  });

  if(sort === 'price-asc') filteredProducts.sort((a,b) => a.price - b.price);
  else if(sort === 'price-desc') filteredProducts.sort((a,b) => b.price - a.price);
  else if(sort === 'rating') filteredProducts.sort((a,b) => b.rating - a.rating);
  else if(sort === 'new') filteredProducts.sort((a,b) => b.isNew - a.isNew);

  document.getElementById('resultCount').innerHTML = '<strong>' + filteredProducts.length + '</strong> товар табылды';
  currentPage = 1;
  renderElecProducts();
  renderPagination();
  updateActiveTags(brands, onlyNew, onlySale);
}

function updateActiveTags(brands, onlyNew, onlySale) {
  const wrap = document.getElementById('activeFilters');
  wrap.innerHTML = '';
  brands.forEach(b => {
    wrap.innerHTML += '<span class="filter-tag">' + b.charAt(0).toUpperCase()+b.slice(1) + ' <button onclick="clearBrand(\''+b+'\')">✕</button></span>';
  });
  if(onlyNew) wrap.innerHTML += '<span class="filter-tag">Жаңы <button onclick="clearCheck(\'f-new\')">✕</button></span>';
  if(onlySale) wrap.innerHTML += '<span class="filter-tag">Скидка <button onclick="clearCheck(\'f-sale\')">✕</button></span>';
}

function clearBrand(b) { document.getElementById('b-'+b).checked = false; applyFilters(); }
function clearCheck(id) { document.getElementById(id).checked = false; applyFilters(); }
function clearFilters() {
  ['apple','samsung','xiaomi','sony','lg','huawei'].forEach(b => { if(document.getElementById('b-'+b)) document.getElementById('b-'+b).checked = false; });
  ['f-new','f-sale','f-instock','r5','r4','r3'].forEach(id => { if(document.getElementById(id)) document.getElementById(id).checked = false; });
  document.getElementById('priceMin').value = 500;
  document.getElementById('priceMax').value = 200000;
  document.getElementById('priceSlider').value = 200000;
  applyFilters();
}

function updatePriceMax(val) {
  document.getElementById('priceMax').value = val;
}

function handleSearch(e) { if(e.key === 'Enter') doSearch(); }
function doSearch() {
  const q = document.getElementById('searchInput').value.toLowerCase().trim();
  if(!q) return;
  showPage('elec');
  currentCat = 'all';
  updateSubCats('all');
  filteredProducts = products.filter(p => p.name.toLowerCase().includes(q) || p.brand.toLowerCase().includes(q));
  document.getElementById('resultCount').innerHTML = '"<strong>' + q + '</strong>" боюнча ' + filteredProducts.length + ' натыйжа';
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-elec').classList.add('active');
  renderElecProducts();
  renderPagination();
  window.scrollTo(0,0);
}

// ===== RENDER =====
function productCardHTML(p) {
  const badgeHTML = p.badge === 'hot' ? '<span class="badge-hot">ХИТ</span>' : p.badge === 'sale' && p.oldPrice ? '<span class="badge-sale">СКИДКА</span>' : p.isNew ? '<span class="badge-new">ЖАҢЫ</span>' : '';
  const discountPct = p.oldPrice ? Math.round((1 - p.price/p.oldPrice)*100) : 0;
  const oldPriceHTML = p.oldPrice ? '<span class="price-old">' + p.oldPrice.toLocaleString() + ' с</span><span class="discount">-' + discountPct + '%</span>' : '';
  const stars = '★'.repeat(p.rating) + '☆'.repeat(5-p.rating);
  const stockBadge = !p.inStock ? '<div style="font-size:11px;color:#EF4444;margin-bottom:6px;font-weight:600;">⚠ Складда жок</div>' : '';
  return `
    <div class="product-card" onclick="showDetail(${p.id})">
      <div class="product-img">${p.icon}${badgeHTML}<span class="wishlist-btn" onclick="event.stopPropagation();toggleWish(this)">🤍</span></div>
      <div class="product-info">
        <div class="product-brand">${p.brand}</div>
        <div class="product-name">${p.name}</div>
        <div class="stars">${stars} <span>(${p.reviews})</span></div>
        <div class="price-row"><span class="price">${p.price.toLocaleString()} с</span>${oldPriceHTML}</div>
        ${stockBadge}
        <button class="add-btn" onclick="event.stopPropagation();addToCart(this,'${p.name}')" ${!p.inStock?'disabled style="background:#94A3B8;cursor:not-allowed"':''}>
          ${p.inStock ? '🛒 Себетке кошуу' : '🔔 Кабарландыруу'}
        </button>
      </div>
    </div>`;
}

function renderElecProducts() {
  const grid = document.getElementById('elecGrid');
  const start = (currentPage-1)*perPage;
  const paginated = filteredProducts.slice(start, start+perPage);
  if(paginated.length === 0) {
    grid.innerHTML = '<div class="no-results" style="grid-column:1/-1"><div class="no-icon">🔍</div><h3>Товар табылган жок</h3><p>Башка фильтр же издөөнү колдонуп көрүңүз</p></div>';
    return;
  }
  grid.innerHTML = paginated.map(productCardHTML).join('');
}

function renderHomeProducts() {
  const el = document.getElementById('home-products');
  if(!el) return;
  const hot = products.filter(p => p.badge === 'hot' || (p.oldPrice && p.rating >= 4)).slice(0,8);
  el.innerHTML = hot.map(p => {
    const badgeHTML = p.badge === 'hot' ? '<span class="badge-hot">ХИТ</span>' : p.oldPrice ? '<span class="badge-sale">СКИДКА</span>' : '';
    const discountPct = p.oldPrice ? Math.round((1-p.price/p.oldPrice)*100) : 0;
    const oldHTML = p.oldPrice ? `<span class="price-old">${p.oldPrice.toLocaleString()} с</span><span class="discount">-${discountPct}%</span>` : '';
    const stars = '★'.repeat(p.rating)+'☆'.repeat(5-p.rating);
    return `<div class="product-card" onclick="showElec('${p.cat}');setTimeout(()=>showDetail(${p.id}),50)">
      <div class="product-img">${p.icon}${badgeHTML}<span class="wishlist-btn" onclick="event.stopPropagation();toggleWish(this)">🤍</span></div>
      <div class="product-info">
        <div class="product-brand">${p.brand}</div>
        <div class="product-name">${p.name}</div>
        <div class="stars">${stars} <span>(${p.reviews})</span></div>
        <div class="price-row"><span class="price">${p.price.toLocaleString()} с</span>${oldHTML}</div>
        <button class="add-btn" onclick="event.stopPropagation();addToCart(this,'${p.name}')">🛒 Себетке кошуу</button>
      </div>
    </div>`;
  }).join('');
}

function renderPagination() {
  const total = Math.ceil(filteredProducts.length / perPage);
  const el = document.getElementById('pagination');
  if(total <= 1) { el.innerHTML = ''; return; }
  let html = '';
  if(currentPage > 1) html += `<button class="page-btn" onclick="goPage(${currentPage-1})">‹</button>`;
  for(let i=1;i<=total;i++) {
    if(i===1||i===total||Math.abs(i-currentPage)<=1) {
      html += `<button class="page-btn ${i===currentPage?'active':''}" onclick="goPage(${i})">${i}</button>`;
    } else if(Math.abs(i-currentPage)===2) html += '<span style="padding:8px 4px;color:var(--muted)">…</span>';
  }
  if(currentPage < total) html += `<button class="page-btn" onclick="goPage(${currentPage+1})">›</button>`;
  el.innerHTML = html;
}

function goPage(n) { currentPage = n; renderElecProducts(); renderPagination(); window.scrollTo(0,200); }


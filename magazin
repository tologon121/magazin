  document.getElementById('tab-'+name).classList.add('active');
  event.target.classList.add('active');
}

// ===== VIEW TOGGLE =====
function setView(mode) {
  isListView = mode === 'list';
  const grid = document.getElementById('elecGrid');
  grid.classList.toggle('list-view', isListView);
  document.getElementById('gridViewBtn').classList.toggle('active', !isListView);
  document.getElementById('listViewBtn').classList.toggle('active', isListView);
}

// ===== CART & WISHLIST =====
function addToCart(btn, name) {
  cartCount++;
  document.getElementById('cartBadge').textContent = cartCount;
  showNotification('✅ "' + (name||'Товар') + '" себетке кошулду!');
  const orig = btn.innerHTML;
  btn.innerHTML = '✓ Кошулду';
  btn.style.background = '#10B981';
  setTimeout(() => { btn.innerHTML = orig; btn.style.background = ''; }, 2000);
}

function toggleWish(btn) {
  if(btn.textContent === '🤍') { btn.textContent = '❤️'; showNotification('❤️ Тандалгыларга кошулду!'); }
  else { btn.textContent = '🤍'; showNotification('💔 Тандалгылардан өчүрүлдү'); }
}

function showNotification(msg) {
  const n = document.getElementById('notification');
  document.getElementById('notif-text').textContent = msg;
  n.classList.add('show');
  setTimeout(() => n.classList.remove('show'), 3000);
}

